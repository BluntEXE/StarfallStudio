<Project Sdk="Dalamud.NET.SDK/14.0.1">
	
	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyTitle>StarfallStudio.API</AssemblyTitle>
		<Product>StarfallStudio</Product>
		<Copyright>Copyright Minmoose © 2025</Copyright>
		<FileVersion>3.0.0.1</FileVersion>
		<AssemblyVersion>3.0.0.1</AssemblyVersion>
		<PackageVersion>3.0.1</PackageVersion>
		<OutputPath>bin\$(Configuration)\</OutputPath>
	</PropertyGroup>

	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Title>StarfallStudio.API</Title>
		<Authors>Minmoose</Authors>
		<RepositoryUrl>https://github.com/Etheirys/StarfallStudio.API</RepositoryUrl>
		<Description>StarfallStudio's external API</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>
	
    <PropertyGroup>
	    <Use_DalamudPackager>false</Use_DalamudPackager>
	    <TargetFramework>net10.0-windows7.0</TargetFramework>
    </PropertyGroup>
	
    <ItemGroup>
      <None Include=".editorconfig" />
    </ItemGroup>
	
</Project>
