<Project Sdk="Dalamud.NET.Sdk/15.0.0">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<AssemblyName>StarfallStudio</AssemblyName>
		<Title>Starfall Studio</Title>
		<Authors>Ehno</Authors>
		<Copyright>Copyright (c) Ehno</Copyright>
		<Description>Combined GPose toolkit - posing, animation, camera, and scene tools in one plugin.</Description>
		<PackageProjectUrl>https://github.com/BluntEXE/StarfallStudio</PackageProjectUrl>
		<RepositoryUrl>https://github.com/BluntEXE/StarfallStudio</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Version>0.2.32</Version>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Resources\Embedded\**\*.*" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\Embedded\**\*.*" />
	</ItemGroup>

	<!-- Include plugin icon in output for Dalamud installer display -->
	<ItemGroup>
		<Content Include="Resources\Embedded\Images\StarfallStudioIcon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>icon.png</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
		<PackageReference Include="MessagePack" Version="3.1.4" />
		<PackageReference Include="YamlDotNet" Version="16.3.0" />
		<PackageReference Include="Blake3" Version="2.2.0" />
		<PackageReference Include="K4os.Compression.LZ4.Legacy" Version="1.3.8" />
		<PackageReference Include="Glamourer.Api" Version="2.8.0" />
		<PackageReference Include="Penumbra.Api" Version="5.13.1" />
		<PackageReference Include="EmbedIO" Version="3.5.2" />
		<PackageReference Include="OneOf" Version="3.0.271" />
		<PackageReference Include="OneOf.SourceGenerator" Version="3.0.271" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Libs\StarfallStudio.API\StarfallStudio.API\StarfallStudio.API.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="StarfallStudio.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="DotNet.ReproducibleBuilds" Version="1.2.39" />
	</ItemGroup>

</Project>
